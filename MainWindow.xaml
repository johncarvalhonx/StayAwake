<Window x:Class="StayAwake.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StayAwake"
        Width="470" Height="790"
        MinWidth="470"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Border Background="{StaticResource Bg}" CornerRadius="16"
            BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= Barra de titulo ================= -->
            <Grid Grid.Row="0" Height="46" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="18" Height="18" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="2.4" />
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" />
                </Grid>

                <TextBlock Grid.Column="1" Text="StayAwake" VerticalAlignment="Center"
                           Margin="10,0,0,0" Foreground="{StaticResource Text}"
                           FontSize="13" FontWeight="SemiBold" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButton}"
                            Content="&#xE921;" ToolTip="Minimizar" Click="BtnMinimize_Click" />
                    <Button x:Name="BtnClose" Style="{StaticResource TitleBarButton}"
                            Content="&#xE8BB;" ToolTip="Esconder na bandeja" Click="BtnClose_Click" />
                </StackPanel>
            </Grid>

            <!-- ================= Conteudo ================= -->
            <ScrollViewer x:Name="ScrollPrincipal" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Padding="16,0,10,16">
                <StackPanel>

                    <!-- Estado -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="58" Height="58" VerticalAlignment="Center">
                                    <Ellipse x:Name="Halo" Fill="{StaticResource Accent}" Opacity="0.12" />
                                    <Ellipse x:Name="Ring" Stroke="{StaticResource Accent}" StrokeThickness="3.5"
                                             Margin="7" />
                                    <Ellipse x:Name="Nucleo" Width="14" Height="14" Fill="{StaticResource Accent}" />
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtState" Text="Desligado" FontSize="20"
                                               FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                    <TextBlock x:Name="TxtStateHint" Text="Seu status vai cair para ausente normalmente."
                                               Style="{StaticResource Hint}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <Button x:Name="BtnToggle" Style="{StaticResource PrimaryButton}"
                                    Content="ATIVAR" Click="BtnToggle_Click" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="TxtUptime" Text="00:00" FontSize="16"
                                               Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                                    <TextBlock Text="ligado há" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="TxtPulses" Text="0" FontSize="16"
                                               Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                                    <TextBlock Text="pulsos enviados" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="TxtNext" Text="-" FontSize="16"
                                               Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                                    <TextBlock Text="próximo pulso" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Método -->
                    <TextBlock Text="COMO MANTER ATIVO" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel x:Name="MethodPanel" />
                    </Border>

                    <!-- Ritmo -->
                    <TextBlock Text="RITMO" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Intervalo entre os pulsos" Style="{StaticResource Label}" />
                            <TextBlock Text="Deixe abaixo do tempo que o app leva para te marcar ausente. No Teams são 5 minutos."
                                       Style="{StaticResource Hint}" Margin="0,2,0,10" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="Chip30" Style="{StaticResource Chip}" Content="30 s"
                                             GroupName="Intervalo" Click="Chip_Click" Tag="30" />
                                <RadioButton x:Name="Chip60" Style="{StaticResource Chip}" Content="1 min"
                                             GroupName="Intervalo" Click="Chip_Click" Tag="60" />
                                <RadioButton x:Name="Chip120" Style="{StaticResource Chip}" Content="2 min"
                                             GroupName="Intervalo" Click="Chip_Click" Tag="120" />
                                <RadioButton x:Name="Chip240" Style="{StaticResource Chip}" Content="4 min"
                                             GroupName="Intervalo" Click="Chip_Click" Tag="240" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBox x:Name="FieldInterval" Style="{StaticResource Field}"
                                         MaxLength="4" TextChanged="FieldInterval_TextChanged" LostFocus="Campo_LostFocus" />
                                <TextBlock Text="segundos" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,0,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Modo inteligente" Style="{StaticResource Label}" />
                                    <TextBlock Text="Só age quando você realmente parou. Enquanto estiver usando o PC, ele não mexe em nada."
                                               Style="{StaticResource Hint}" />
                                </StackPanel>
                                <ToggleButton x:Name="SwSmart" Grid.Column="1" Style="{StaticResource Switch}"
                                              Click="Setting_Changed" />
                            </Grid>

                            <StackPanel x:Name="SmartRow" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Esperar" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="FieldSmartIdle" Style="{StaticResource Field}"
                                         MaxLength="4" TextChanged="Field_TextChanged" LostFocus="Campo_LostFocus" />
                                <TextBlock Text="segundos parado antes de agir" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Energia -->
                    <TextBlock Text="ENERGIA" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Impedir suspensão" Style="{StaticResource Label}" />
                                    <TextBlock Text="O PC não dorme enquanto o StayAwake estiver ligado."
                                               Style="{StaticResource Hint}" />
                                </StackPanel>
                                <ToggleButton x:Name="SwSystem" Grid.Column="1" Style="{StaticResource Switch}"
                                              Click="Setting_Changed" />
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Manter a tela ligada" Style="{StaticResource Label}" />
                                    <TextBlock Text="Segura a tela e o protetor de tela. Não impede o bloqueio por política da empresa."
                                               Style="{StaticResource Hint}" />
                                </StackPanel>
                                <ToggleButton x:Name="SwDisplay" Grid.Column="1" Style="{StaticResource Switch}"
                                              Click="Setting_Changed" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Limites -->
                    <TextBlock Text="LIMITES" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Desligar sozinho" Style="{StaticResource Label}" />
                                    <TextBlock Text="Encerra depois de um tempo, para não ficar ligado a noite toda."
                                               Style="{StaticResource Hint}" />
                                </StackPanel>
                                <ToggleButton x:Name="SwAutoStop" Grid.Column="1" Style="{StaticResource Switch}"
                                              Click="Setting_Changed" />
                            </Grid>

                            <StackPanel x:Name="AutoStopRow" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Depois de" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="FieldAutoStop" Style="{StaticResource Field}"
                                         MaxLength="4" TextChanged="Field_TextChanged" LostFocus="Campo_LostFocus" />
                                <TextBlock Text="minutos" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,14,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Somente no horário" Style="{StaticResource Label}" />
                                    <TextBlock Text="Fora da faixa ele fica em espera, sem enviar nada."
                                               Style="{StaticResource Hint}" />
                                </StackPanel>
                                <ToggleButton x:Name="SwSchedule" Grid.Column="1" Style="{StaticResource Switch}"
                                              Click="Setting_Changed" />
                            </Grid>

                            <StackPanel x:Name="ScheduleRow" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Das" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="FieldStart" Style="{StaticResource Field}"
                                         MaxLength="5" TextChanged="Field_TextChanged" LostFocus="Campo_LostFocus" />
                                <TextBlock Text="às" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="8,0,8,0" />
                                <TextBox x:Name="FieldEnd" Style="{StaticResource Field}"
                                         MaxLength="5" TextChanged="Field_TextChanged" LostFocus="Campo_LostFocus" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- App -->
                    <TextBlock Text="APLICATIVO" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Abrir junto com o Windows"
                                           Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <ToggleButton x:Name="SwStartup" Grid.Column="1" Style="{StaticResource Switch}"
                                              Click="SwStartup_Click" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Começar minimizado na bandeja"
                                           Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <ToggleButton x:Name="SwStartMin" Grid.Column="1" Style="{StaticResource Switch}"
                                              Click="Setting_Changed" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Já ativar ao abrir o app"
                                           Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <ToggleButton x:Name="SwAutoEngine" Grid.Column="1" Style="{StaticResource Switch}"
                                              Click="Setting_Changed" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Botão fechar esconde na bandeja"
                                           Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <ToggleButton x:Name="SwCloseToTray" Grid.Column="1" Style="{StaticResource Switch}"
                                              Click="Setting_Changed" />
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource GhostButton}"
                                        Content="Testar pulso agora" Click="BtnTest_Click" />
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                        Content="Sair do StayAwake" Click="BtnQuit_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Atividade -->
                    <TextBlock Text="ATIVIDADE" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource CardBorder}" Padding="8">
                        <ScrollViewer x:Name="LogScroll" Height="150" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Hora}" FontSize="11"
                                                       FontFamily="Consolas" Foreground="{StaticResource Muted}"
                                                       Margin="0,0,8,0" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding Mensagem}" FontSize="11"
                                                       Foreground="{Binding Cor}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock x:Name="TxtFooter" Style="{StaticResource Hint}" Margin="4,0,0,4"
                               Text="Com a tela bloqueada nenhum app consegue manter você disponível no Teams." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
